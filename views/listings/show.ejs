<% layout("/layouts/boilerplate") %>

<div class="mt-3">
    <div class="row">
        <div class="col-12">
            <h3 class="d-inline-block"><%= listing.title %></h3>
            <% if(currUser){ %>
            <form method="POST" action="/listings/<%= listing._id %>/wishlist" class="d-inline-block ms-2">
                <button type="submit" class="btn <%= isSaved ? 'btn-danger' : 'btn-outline-danger' %>">
                    <i class="fa-solid fa-heart"></i> <%= isSaved ? t('saved') : t('save') %>
                </button>
            </form>
            <% if(isSaved && savedPrice && listing.price > savedPrice){ %>
            <div>
                <span class="badge bg-success"><i class="fa-solid fa-arrow-down"></i> <%= t("priceDropped",{X:(listing.price-savedPrice).toLocaleString("en-IN")}) %></span>
            </div>
            <% } %>
            <% } %>
        </div>
    </div>
    <div class="row g-0">
        <div class="col-lg-8 pe-lg-3">
            <div class="card show-card listing-card">
                <img src="<%= listing.image?.url || 'https://placehold.co/600x400?text=No+Image' %>" class="card-img-top" alt="<%= listing.title %>">
                <div class="card-body">
                    <p class="card-text">
                        <%= listing.description %><br>
                        &#8377;<%= listing.price.toLocaleString("en-IN") %> per night<br>
                        <%= listing.location %>, <%= listing.country %><br>
                        <small class="text-muted">Listed by: <%= listing.owner?.username || 'Unknown' %></small>
                    </p>
                </div>
            </div>
            <% if(currUser && listing.owner && currUser._id.equals(listing.owner._id)) { %>
            <div class="my-3">
                <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark">Edit</a>
                <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" class="d-inline">
                    <button type="submit" class="btn btn-dark">Delete</button>
                </form>
            </div>
            <% } %>
            <div class="my-3">
                <h4>Leave a Review</h4>
                <form action="/listings/<%= listing.id %>/reviews" method="POST" novalidate class="needs-validation">
                    <div class="mb-3 mt-3">
                        <label for="rating">Rating</label>
                        <fieldset class="starability-basic">
                            <legend class="visually-hidden">Rate this listing</legend>
                            <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                            <label for="first-rate1" title="Terrible">1 star</label>
                            <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                            <label for="first-rate2" title="Not good">2 stars</label>
                            <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                            <label for="first-rate3" title="Average">3 stars</label>
                            <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                            <label for="first-rate4" title="Very good">4 stars</label>
                            <input type="radio" id="first-rate5" name="review[rating]" value="5" checked />
                            <label for="first-rate5" title="Amazing">5 stars</label>
                        </fieldset>
                    </div>
                    <div>
                        <label for="comment" class="form-label"> Comments</label>
                        <textarea name="review[comment]" id="comment" cols="30" rows="5" class="form-control" required></textarea>
                        <div class="invalid-feedback">Please submit some comments for review</div>
                    </div>
                    <button class="btn btn-outline">Submit </button>
                </form>
            </div>
            <hr>
            <p><b>All Reviews</b></p>
            <div class="row g-3">
                <% for(let review of listing.reviews){ %>
                <div class="col-md-6">
                    <div class="card h-100">
                        <div class="card-body">
                            <h5 class="card-title"><%= review.author ? review.author.username : "Anonymous" %></h5>
                            <p class="card-text"><%= review.comment %></p>
                            <div class="starability-result" data-rating="<%= review.rating %>" aria-label="Rated <%= review.rating %> out of 5"></div>
                        </div>
                        <% if(currUser){ %>
                        <form class="mb-3" method="POST" action="/listings/<%= listing._id%>/reviews/<%=review._id%>?_method=DELETE">
                            <button class="btn btn-sm btn-dark">Delete</button>
                        </form>
                        <% } %>
                    </div>
                </div>
                <% } %>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card listing-card sticky-top" style="top:70px">
                <% if(listing.price && currUser && listing.owner && !currUser._id.equals(listing.owner._id)) { %>
                <div class="card-body">
                    <h5 class="card-title">&#8377;<%= listing.price.toLocaleString("en-IN") %> <small class="text-muted"><%= t("perNight") %></small></h5>
                    <p class="mb-2"><span class="badge bg-success"><i class="fa-solid fa-bolt"></i> <%= t("instantBooking") %></span></p>
                    <form id="booking-form" data-price="<%= listing.price || 0 %>" method="POST" action="/listings/<%= listing._id %>/bookings">
                        <div class="row g-2">
                            <div class="col-6 mb-3">
                                <label for="checkIn" class="form-label"><%= t("checkIn") %></label>
                                <input type="date" id="checkIn" name="checkIn" class="form-control" min="<%= new Date().toISOString().split('T')[0] %>" required>
                            </div>
                            <div class="col-6 mb-3">
                                <label for="checkOut" class="form-label"><%= t("checkOut") %></label>
                                <input type="date" id="checkOut" name="checkOut" class="form-control" min="<%= new Date().toISOString().split('T')[0] %>" required>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label for="guests" class="form-label"><%= t("guests") %></label>
                            <input type="number" id="guests" name="guests" class="form-control" min="1" max="16" value="1" required>
                        </div>
                        <div id="price-breakdown" class="mb-3 d-none" data-nights="<%= t('nights') %>">
                            <table class="table table-sm mb-1">
                                <tbody>
                                    <tr><td class="text-muted"><span id="nights-label">--</span> &#215; &#8377;<span id="rate-label">0</span></td><td class="text-end">&#8377;<span id="subtotal-label">0</span></td></tr>
                                    <tr><td class="text-muted"><%= t("guestFee") %></td><td class="text-end"><span class="text-success">&#8377;0</span></td></tr>
                                </tbody>
                            </table>
                            <div class="d-flex justify-content-between fw-bold">
                                <span><%= t("total") %> (<span id="total-nights-label">--</span>)</span>
                                <span id="total-price">--</span>
                            </div>
                            <div id="deposit-block" class="d-none border-top mt-2 pt-2 small">
                                <div class="d-flex justify-content-between"><span><%= t("deposit") %> (20%)</span><span>&#8377;<span id="deposit-label">0</span></span></div>
                                <div class="d-flex justify-content-between"><span><%= t("balanceDue") %></span><span>&#8377;<span id="balance-label">0</span></span></div>
                                <span class="badge bg-warning text-dark mt-1"><i class="fa-solid fa-lock"></i> <%= t("priceLocked") %></span>
                            </div>
                        </div>
                        <div class="mb-3">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="paymentMode" id="payFull" value="full" checked>
                                <label class="form-check-label" for="payFull"><%= t("payFullNow") %></label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="paymentMode" id="payDeposit" value="deposit">
                                <label class="form-check-label" for="payDeposit"><%= t("depositLock") %></label>
                            </div>
                        </div>
                        <button type="submit" class="btn btn-primary w-100"><%= t("reserve") %></button>
                    </form>
                    <p class="text-muted small mt-3 mb-1"><i class="fa-solid fa-circle-check text-success"></i> <%= t("instantBookingNote") %></p>
                    <p class="text-muted small mb-0"><i class="fa-solid fa-receipt"></i> <%= t("transparentNote") %></p>
                </div>
                <% } else if(listing.price && !currUser){ %>
                <div class="card-body text-center">
                    <p class="card-text mb-3">&#8377;<%= listing.price.toLocaleString("en-IN") %> <%= t("perNight") %></p>
                    <a href="/login" class="btn btn-primary w-100"><%= t("loginToBook") %></a>
                </div>
                <% } %>
                <% if(listing.geometry?.coordinates && mapboxToken){ %>
                <div id="map" data-lng="<%= listing.geometry.coordinates[0] %>" data-lat="<%= listing.geometry.coordinates[1] %>" data-token="<%= mapboxToken %>" data-title="<%= listing.title %>" data-location="<%= listing.location %>, <%= listing.country %>"></div>
                <% } %>
            </div>
        </div>
    </div>
</div>

<% if(listing.geometry?.coordinates && mapboxToken){ %>
<link href="https://api.mapbox.com/mapbox-gl-js/v3.4.0/mapbox-gl.css" rel="stylesheet">
<script src="https://api.mapbox.com/mapbox-gl-js/v3.4.0/mapbox-gl.js"></script>
<style>#map{height:320px;border-radius:0.5rem;border:1px solid #dee2e6;}</style>
<% } %>

<script>
(function(){
    const bookingForm = document.getElementById("booking-form");
    if(!bookingForm) return;
    const pricePerNight = Number(bookingForm.dataset.price || 0);
    const checkIn = document.getElementById("checkIn");
    const checkOut = document.getElementById("checkOut");
    const breakdown = document.getElementById("price-breakdown");
    const nightsLabel = document.getElementById("nights-label");
    const totalNightsLabel = document.getElementById("total-nights-label");
    const rateLabel = document.getElementById("rate-label");
    const subtotalLabel = document.getElementById("subtotal-label");
    const totalPrice = document.getElementById("total-price");
    const depositBlock = document.getElementById("deposit-block");
    const depositLabel = document.getElementById("deposit-label");
    const balanceLabel = document.getElementById("balance-label");
    const payDeposit = document.getElementById("payDeposit");
    const payFull = document.getElementById("payFull");
    function fmt(n){ return (n||0).toLocaleString("en-IN"); }
    function updateTotal() {
        if(!checkIn || !checkOut || !checkIn.value || !checkOut.value){
            breakdown.classList.add("d-none");
            return;
        }
        const inD = new Date(checkIn.value), outD = new Date(checkOut.value);
        const nights = Math.round((outD - inD) / (1000*60*60*24));
        if(nights <= 0){
            breakdown.classList.add("d-none");
            return;
        }
        const subtotal = nights * pricePerNight;
        const nightsWord = breakdown.dataset.nights || "nights";
        nightsLabel.textContent = nights;
        totalNightsLabel.textContent = nights + " " + nightsWord;
        rateLabel.textContent = fmt(pricePerNight);
        subtotalLabel.textContent = fmt(subtotal);
        totalPrice.textContent = "Rs. " + fmt(subtotal);
        const isDeposit = payDeposit && payDeposit.checked;
        if(isDeposit){
            const deposit = Math.round(subtotal * 0.2);
            depositLabel.textContent = fmt(deposit);
            balanceLabel.textContent = fmt(subtotal - deposit);
            depositBlock.classList.remove("d-none");
        } else {
            depositBlock.classList.add("d-none");
        }
        breakdown.classList.remove("d-none");
    }
    checkIn.addEventListener("change", updateTotal);
    checkOut.addEventListener("change", updateTotal);
    payFull.addEventListener("change", updateTotal);
    payDeposit.addEventListener("change", updateTotal);
    updateTotal();
})();
</script>

<% if(listing.geometry?.coordinates && mapboxToken){ %>
<script>
(function(){
    const mapEl = document.getElementById("map");
    if(!mapEl) return;
    const coordinates = [Number(mapEl.dataset.lng), Number(mapEl.dataset.lat)];
    mapboxgl.accessToken = mapEl.dataset.token;
    const map = new mapboxgl.Map({
        container: "map",
        style: "mapbox://styles/mapbox/streets-v12",
        center: coordinates,
        zoom: 13,
    });
    new mapboxgl.Marker()
        .setLngLat(coordinates)
        .setPopup(new mapboxgl.Popup({ offset: 25 }).setDOMContent(mapPopupContent(mapEl)))
        .addTo(map);
    function mapPopupContent(mapEl){
        const wrap = document.createElement("div");
        const h = document.createElement("h6");
        h.textContent = mapEl.dataset.title || "";
        const p = document.createElement("p");
        p.className = "mb-0";
        p.textContent = mapEl.dataset.location || "";
        wrap.append(h, p);
        return wrap;
    }
})();
</script>
<% } %>