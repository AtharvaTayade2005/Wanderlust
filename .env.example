# Copy this file to .env and fill in your own credentials.
# NOTE: .env.example is committed to git — never put real secrets here.

# Cloudinary (https://cloudinary.com) - used for listing image uploads
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Session secret
SESSION_SECRET=change_me

# Mapbox (https://mapbox.com) - used to show listing locations on a map
MAPBOX_TOKEN=your_mapbox_token

# MongoDB connection string (MongoDB Atlas in production)
MONGODB_URL=mongodb://127.0.0.1:27017/wanderlust

# Port the server listens on
PORT=8080

# Razorpay (https://razorpay.com) - used for booking payments (test mode keys look like rzp_test_*)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret